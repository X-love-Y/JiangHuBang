/* ai —— AI 助手 */
.ai-page {
  padding-bottom: 60rpx;
}

/* 月卡状态条 */
.pass-bar {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.pass-bar--on {
  background: linear-gradient(135deg, rgba(255, 251, 235, 0.95), rgba(255, 255, 255, 0.85));
  border: 1rpx solid rgba(201, 162, 39, 0.28);
}
.pass-bar__icon {
  font-size: 52rpx;
}
.pass-bar__body {
  flex: 1;
  min-width: 0;
}
.pass-bar__title {
  font-size: 30rpx;
  font-weight: 700;
}
.pass-bar__text {
  font-size: 22rpx;
  color: var(--ink-2);
  margin-top: 4rpx;
  line-height: 1.5;
}

/* 区块 */
.block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.block-title {
  font-size: 30rpx;
  font-weight: 700;
}
.block-sub {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}

/* 推荐结果 */
.rec-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.rec-card {
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(74, 123, 208, 0.14);
  box-shadow: 0 6rpx 18rpx rgba(31, 35, 55, 0.05);
  transition: transform 150ms var(--ease-out);
}
.rec-card--active {
  transform: scale(0.98);
}
.rec-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.rec-card__title {
  flex: 1;
  font-size: 27rpx;
  font-weight: 700;
}
.rec-card__amount {
  font-size: 27rpx;
  font-weight: 800;
  color: var(--cinnabar);
  flex-shrink: 0;
}
.rec-card__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}
.rec-card__no {
  font-size: 20rpx;
  color: var(--ink-3);
}
.rec-card__reason {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--ink-2);
  line-height: 1.6;
}
.rec-empty {
  text-align: center;
  font-size: 21rpx;
  color: var(--ink-3);
  padding: 12rpx 0;
}

/* 方案 */
.pick-scroll {
  white-space: nowrap;
  width: 100%;
}
.pick-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 2rpx;
}
.chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  font-size: 23rpx;
  color: var(--ink-2);
  box-shadow: 0 4rpx 14rpx rgba(31, 35, 55, 0.05);
  transition: all 150ms var(--ease-out);
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}
.chip--on {
  background: linear-gradient(135deg, #2A2A2E 0%, #1C1C1E 100%);
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 8rpx 20rpx rgba(28, 28, 30, 0.20);
}
.chip--active {
  transform: scale(0.95);
}
.solution-btn {
  margin-top: 24rpx;
  width: 100%;
}
.solution-body {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(74, 123, 208, 0.06);
  border: 1rpx solid rgba(74, 123, 208, 0.12);
}
.solution-text {
  font-size: 26rpx;
  line-height: 1.9;
  white-space: pre-wrap;
  word-break: break-all;
}
