/* user-home —— 个人主页 */
.user-home {
  padding-bottom: 60rpx;
}

.user-card {
  padding: 36rpx 32rpx;
}
.user-card--gold {
  background: linear-gradient(150deg, rgba(255, 243, 214, 0.95), rgba(255, 255, 255, 0.85) 55%, rgba(201, 162, 39, 0.18));
  border: 1rpx solid rgba(201, 162, 39, 0.30);
}
.user-card--ink {
  background: linear-gradient(150deg, rgba(232, 234, 240, 0.96), rgba(255, 255, 255, 0.85) 60%, rgba(28, 28, 30, 0.10));
  border: 1rpx solid rgba(28, 28, 30, 0.14);
}
.user-card__top {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.user-card__avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  box-shadow: 0 10rpx 26rpx rgba(31, 35, 55, 0.16);
}
.user-card__avatar--placeholder {
  background: linear-gradient(135deg, #D8DBE4, #C2C7D4);
  color: #FFF;
  font-size: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.user-card__info {
  flex: 1;
  min-width: 0;
}
.user-card__name {
  font-size: 34rpx;
  font-weight: 800;
}
.user-card__title {
  margin-top: 8rpx;
}
.user-card__bio {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.user-card__meta {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}
.user-card__rating {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  color: var(--ink-2);
}
.rating-star {
  color: var(--star);
  font-size: 28rpx;
}
.rating-num {
  font-weight: 700;
}
.rating-count {
  color: var(--ink-3);
}

.section-label {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--ink-2);
  margin-bottom: 16rpx;
}

/* 三角图 */
.radar-card {
  margin-top: 24rpx;
}
.radar-canvas {
  width: 100%;
  height: 460rpx;
}
.radar-locked {
  margin-top: 24rpx;
  text-align: center;
  padding: 60rpx 0;
  font-size: 25rpx;
  color: var(--ink-3);
  letter-spacing: 2rpx;
}

/* 统计 */
.stats-card {
  margin-top: 24rpx;
  display: flex;
}
.stats-card__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.stats-card__value {
  font-size: 36rpx;
  font-weight: 800;
}
.stats-card__label {
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 完成记录 */
.done-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(28, 28, 30, 0.05);
  border-radius: 16rpx;
  transition: background 150ms;
}
.done-item:last-child {
  border-bottom: none;
}
.done-item--active {
  background: rgba(28, 28, 30, 0.03);
}
.done-item__title {
  flex: 1;
  font-size: 26rpx;
  font-weight: 500;
}
.done-item__right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}
.done-item__star {
  font-size: 22rpx;
  color: var(--star);
}
.done-item__amount {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--cinnabar);
}

/* 隐私设置 */
.privacy-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}
.privacy-item__label {
  font-size: 27rpx;
}
.privacy-hint {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--ink-3);
  text-align: center;
}
