/* home —— 主页：玻璃拟态四按钮布局（2 竖排矩形 + 2 圆形） */
page {
  background: #F2F3F7;
}

.home {
  position: fixed;
  inset: 0;
  background: linear-gradient(160deg, #F7F8FB 0%, #EDEFF4 50%, #E9EBF1 100%);
  overflow: hidden;
}

.blob--a {
  width: 620rpx;
  height: 620rpx;
  background: radial-gradient(circle, rgba(201, 162, 39, 0.13), transparent 70%);
  top: -160rpx;
  right: -200rpx;
}
.blob--b {
  width: 700rpx;
  height: 700rpx;
  background: radial-gradient(circle, rgba(74, 123, 208, 0.09), transparent 70%);
  bottom: -220rpx;
  left: -240rpx;
}
.blob--c {
  width: 460rpx;
  height: 460rpx;
  background: radial-gradient(circle, rgba(194, 75, 58, 0.07), transparent 70%);
  top: 34%;
  right: -140rpx;
}

.home__body {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 72rpx;
  box-sizing: border-box;
  padding: 24rpx 40rpx;
}

/* ===== 上方：两个全宽横向矩形（竖排堆叠） ===== */
.home__rects {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
  width: 100%;
}

.btn-rect {
  width: 100%;
  height: 340rpx;
  border-radius: 48rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  transition: transform 220ms var(--ease-smooth), box-shadow 220ms var(--ease-smooth);
}
.btn-rect--active {
  transform: scale(0.94);
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 55, 0.06);
}

.btn-rect__icon {
  width: 84rpx;
  height: 84rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  opacity: 0.92;
}
.btn-rect__icon--publish {
  background-image: url("data:image/svg+xml;base64,");
}
.btn-rect__icon--find {
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCA0OCA0OCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjMUMxQzFFIiBzdHJva2Utd2lkdGg9IjIuNCIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIj48Y2lyY2xlIGN4PSIyMSIgY3k9IjIxIiByPSIxMyIvPjxsaW5lIHgxPSIzMSIgeTE9IjMxIiB4Mj0iNDAiIHkyPSI0MCIvPjwvc3ZnPg==");
}

.btn-rect__label {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  color: var(--ink);
}

/* ===== 下方圆形按钮 ===== */
.home__circles {
  display: flex;
  justify-content: center;
  gap: 96rpx;
  width: 100%;
}

.btn-circle {
  width: 248rpx;
  height: 248rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  transition: transform 220ms var(--ease-smooth), box-shadow 220ms var(--ease-smooth);
}
.btn-circle--active {
  transform: scale(0.93);
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 55, 0.06);
}

.btn-circle__icon {
  width: 64rpx;
  height: 64rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  opacity: 0.92;
}
.btn-circle__icon--ai {
  background-image: url("data:image/svg+xml;base64,");
}
.btn-circle__icon--me {
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCA0OCA0OCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjMUMxQzFFIiBzdHJva2Utd2lkdGg9IjIuNCIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIj48Y2lyY2xlIGN4PSIyNCIgY3k9IjE2IiByPSI4Ii8+PHBhdGggZD0iTTggNDIgUTggMjkgMjQgMjkgUTQwIDI5IDQwIDQyIi8+PC9zdmc+");
