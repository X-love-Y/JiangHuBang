/* recharge —— 扫码充值（模拟） */
.recharge-page {
  padding-bottom: 60rpx;
}
.plan-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.plan {
  flex: 1;
  min-width: 28%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 24rpx 12rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 4rpx 14rpx rgba(31, 35, 55, 0.05);
  transition: all 150ms var(--ease-out);
}
.plan--on {
  background: linear-gradient(135deg, #2A2A2E 0%, #1C1C1E 100%);
  border-color: transparent;
  box-shadow: 0 10rpx 26rpx rgba(28, 28, 30, 0.24);
}
.plan--on .plan__silver {
  color: #FFFFFF;
}
.plan--on .plan__rmb {
  color: rgba(255, 255, 255, 0.6);
}
.plan--active {
  transform: scale(0.96);
}
.plan__silver {
  font-size: 28rpx;
  font-weight: 700;
}
.plan__rmb {
  font-size: 24rpx;
  color: var(--ink-3);
}

.qr-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.qr-canvas {
  width: 400rpx;
  height: 400rpx;
}
.qr-hint {
  font-size: 22rpx;
  color: var(--gold-deep);
}
.qr-order {
  font-size: 21rpx;
  color: var(--ink-3);
  word-break: break-all;
  text-align: center;
}
.pay-btn {
  width: 100%;
}
.qr-tip {
  font-size: 21rpx;
  color: var(--ink-3);
  text-align: center;
  line-height: 1.6;
}
