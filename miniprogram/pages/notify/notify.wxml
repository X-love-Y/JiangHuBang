<view class="page-container notify-page">
  <view class="glass-card fade-up notify-card {{!item.read ? 'notify-card--unread' : ''}}"
    hover-class="notify-card--active"
    wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" data-related="{{item.relatedId}}" bindtap="tapNotify">
    <view class="notify-card__top">
      <text class="notify-card__title">{{item.title}}</text>
      <view class="notify-card__dot" wx:if="{{!item.read}}"></view>
    </view>
    <view class="notify-card__content">{{item.content}}</view>
    <view class="notify-card__time">{{item.timeText}}</view>
  </view>

  <empty-state wx:if="{{!list.length && !loading}}" icon="🔔" text="暂无通知" />
</view>
