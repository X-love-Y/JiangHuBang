/* publish —— 发布委托表单 */
.balance-inline {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  font-weight: 400;
  color: var(--ink-3);
  letter-spacing: 0;
}
.field__label--between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.balance-inline {
  font-size: 23rpx;
  font-weight: 400;
  color: var(--ink-3);
  letter-spacing: 0;
}

.form-card {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.field__label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
}
.field__req {
  color: var(--cinnabar);
}
.field__hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

.ph {
  color: var(--ink-3);
}

.textarea {
  min-height: 160rpx;
  width: 100%;
}

/* 分类 chips */
.chips {
  white-space: nowrap;
  width: 100%;
}
.chip {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  color: var(--ink-2);
  box-shadow: 0 4rpx 14rpx rgba(31, 35, 55, 0.05);
  transition: all 150ms var(--ease-out);
}
.chip--on {
  background: linear-gradient(135deg, #2A2A2E 0%, #1C1C1E 100%);
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 8rpx 22rpx rgba(28, 28, 30, 0.22);
}
.chip--active {
  transform: scale(0.96);
}
.subchips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}
.chip--sm {
  margin-right: 0;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}

/* 地区/时间 picker 行 */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
}
.picker-arrow {
  color: var(--ink-3);
  font-size: 36rpx;
  transform: rotate(90deg) scaleX(1.4);
}

/* 币种切换 */
.currency-seg {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.seg {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  font-size: 27rpx;
  color: var(--ink-2);
  box-shadow: 0 4rpx 14rpx rgba(31, 35, 55, 0.05);
  transition: all 150ms var(--ease-out);
}
.seg--on {
  background: linear-gradient(135deg, #2A2A2E 0%, #1C1C1E 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 22rpx rgba(28, 28, 30, 0.22);
}
.seg--active {
  transform: scale(0.97);
}

/* 金额输入 */
.amount-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
/* flex:1 与 .glass-input 的 width:100% 冲突会撑破行宽，须显式 width:auto 覆盖 */
.amount-input {
  flex: 1;
  width: auto;
  font-size: 36rpx;
  font-weight: 600;
}
.amount-unit {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-2);
  width: 48rpx;
}

/* 星级预览 */
.star-preview {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 20rpx 28rpx;
  border-radius: 28rpx;
  background: var(--gold-soft);
}
.star-preview__desc {
  font-size: 24rpx;
  color: var(--gold-deep);
  font-weight: 600;
}

/* 图片网格 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img-cell {
  position: relative;
  width: 156rpx;
  height: 156rpx;
  border-radius: 24rpx;
  overflow: hidden;
}
.img-cell image {
  width: 100%;
  height: 100%;
}
.img-cell__del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(28, 28, 30, 0.55);
  color: #FFF;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8rpx);
}
.img-cell--add {
  border: 2rpx dashed rgba(28, 28, 30, 0.18);
  background: rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-add-plus {
  font-size: 56rpx;
  color: var(--ink-3);
  line-height: 1;
}
.img-cell--active {
  transform: scale(0.96);
}

/* 公共模式 */
.acceptor-range {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}
.range-input {
  flex: 1;
  width: auto;
  text-align: center;
}
.range-sep {
  color: var(--ink-3);
  font-size: 26rpx;
}
.range-unit {
  font-size: 26rpx;
  color: var(--ink-2);
}
.split-seg {
  margin-top: 16rpx;
  margin-bottom: 0;
}
.seg--sm {
  padding: 14rpx 0;
  font-size: 24rpx;
}

/* 定时发布 */
.publish-time-row {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}
.publish-time-cell {
  flex: 1;
  width: auto;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 40rpx;
  width: 100%;
}
.draft-btn {
  margin-top: 24rpx;
  width: 100%;
}

/* AI 评定 */
.ai-assess {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(74, 123, 208, 0.07);
  border: 1rpx solid rgba(74, 123, 208, 0.16);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.ai-assess__row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.ai-assess__star {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--info);
}
.ai-assess__reason {
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.6;
}
.ai-assess-btn {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--info);
  border: 1rpx dashed rgba(74, 123, 208, 0.35);
  border-radius: var(--radius-pill);
  padding: 14rpx;
  transition: transform 120ms var(--ease-out);
}
.ai-assess-btn--active {
  transform: scale(0.96);
}

/* seg 内嵌硬币图标：横向排列居中 */
.seg {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
.seg__label {
  font-size: inherit;
}
