/* drafts —— 草稿箱 */
.drafts-page {
  padding-bottom: 60rpx;
}

.draft-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 24rpx;
}
.draft-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.draft-card__title {
  flex: 1;
  font-size: 29rpx;
  font-weight: 700;
}
.draft-card__meta {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex-wrap: wrap;
  font-size: 23rpx;
  color: var(--ink-2);
}
.draft-card__amount {
  font-weight: 800;
  color: var(--cinnabar);
  font-size: 26rpx;
}
.draft-card__mode {
  font-size: 22rpx;
}
.draft-card__time {
  color: var(--gold-deep);
}
.draft-card__chain {
  font-size: 22rpx;
  color: var(--info);
  background: rgba(74, 123, 208, 0.08);
  border-radius: 14rpx;
  padding: 10rpx 16rpx;
}
.draft-card__fail {
  font-size: 22rpx;
  color: var(--danger);
}

.draft-card__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(28, 28, 30, 0.05);
  flex-wrap: wrap;
}
.draft-action {
  font-size: 23rpx;
  color: var(--ink-2);
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(28, 28, 30, 0.10);
  border-radius: var(--radius-pill);
  padding: 10rpx 24rpx;
  transition: transform 120ms var(--ease-out);
}
.draft-action--primary {
  background: linear-gradient(135deg, #2A2A2E 0%, #1C1C1E 100%);
  color: #FFFFFF;
  border-color: transparent;
  font-weight: 600;
}
.draft-action--active {
  transform: scale(0.94);
}
.draft-action--danger {
  color: var(--danger);
  border-color: rgba(217, 83, 79, 0.30);
}

/* 视图切换 */
.tabs {
  display: flex;
  padding: 8rpx;
  border-radius: var(--radius-pill);
  margin-bottom: 24rpx;
}
.tabs__item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: var(--radius-pill);
  font-size: 27rpx;
  color: var(--ink-2);
  transition: all 180ms var(--ease-out);
}
.tabs__item--on {
  background: linear-gradient(135deg, #2A2A2E 0%, #1C1C1E 100%);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(28, 28, 30, 0.20);
}
.tabs__item--active {
  transform: scale(0.97);
}

/* 链卡片 */
.chain-card {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.chain-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(28, 28, 30, 0.06);
  flex-wrap: wrap;
}
.chain-card__id {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--info);
}
.chain-card__summary {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}
.chain-card__actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

/* 链步骤 */
.chain-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(28, 28, 30, 0.04);
}
.chain-step:last-child {
  border-bottom: none;
}
.chain-step__seq {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(74, 123, 208, 0.12);
  color: var(--info);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.chain-step__body {
  flex: 1;
  min-width: 0;
}
.chain-step__title {
  font-size: 26rpx;
  font-weight: 600;
}
.chain-step__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
  flex-wrap: wrap;
}
.chain-step__trigger {
  font-size: 21rpx;
  color: var(--ink-3);
}
.chain-step__time {
  font-size: 21rpx;
  color: var(--gold-deep);
}
.chain-step__ops {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.op-link {
  font-size: 21rpx;
  color: var(--info);
  background: rgba(74, 123, 208, 0.08);
  border-radius: var(--radius-pill);
  padding: 6rpx 14rpx;
  transition: transform 120ms var(--ease-out);
}
.op-link--danger {
  color: var(--danger);
  background: rgba(217, 83, 79, 0.08);
}
.op-link--active {
  transform: scale(0.93);
}

/* 历史链 */
.history-card {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.history-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.history-card__id {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--ink-2);
}
.history-card__time {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}
.history-card__steps {
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.8;
  background: rgba(28, 28, 30, 0.04);
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
}
