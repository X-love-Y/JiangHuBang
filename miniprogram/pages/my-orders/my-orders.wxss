/* my-orders —— 我的委托 */
.tabs {
  display: flex;
  padding: 8rpx;
  border-radius: var(--radius-pill);
  margin-bottom: 24rpx;
}
.tabs__item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  color: var(--ink-2);
  transition: all 180ms var(--ease-out);
}
.tabs__item--on {
  background: linear-gradient(135deg, #2A2A2E 0%, #1C1C1E 100%);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(28, 28, 30, 0.20);
}
.tabs__item--active {
  transform: scale(0.97);
}

.status-scroll {
  white-space: nowrap;
  width: 100%;
  margin-bottom: 28rpx;
}
.status-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 2rpx;
}
.chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  font-size: 23rpx;
  color: var(--ink-2);
  box-shadow: 0 4rpx 14rpx rgba(31, 35, 55, 0.05);
  transition: all 150ms var(--ease-out);
}
.chip--on {
  background: linear-gradient(135deg, #2A2A2E 0%, #1C1C1E 100%);
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 8rpx 20rpx rgba(28, 28, 30, 0.20);
}
.chip--active {
  transform: scale(0.95);
}

.orders {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.order-card {
  transition: transform 150ms var(--ease-out);
}
.order-card--active {
  transform: scale(0.98);
}
.order-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.order-card__title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
}
.order-card__mid {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
}
.order-card__amount {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--cinnabar);
}
.order-card__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(28, 28, 30, 0.05);
  font-size: 23rpx;
  color: var(--ink-3);
}
.order-card__party {
  max-width: 55%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.list-footer {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  padding: 32rpx 0 20rpx;
  letter-spacing: 2rpx;
}
