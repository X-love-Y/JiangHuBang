/* wallet —— 钱包 */
.wallet-page {
  padding-bottom: 60rpx;
}

/* 余额卡 */
.balance-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 40rpx 32rpx;
}
.balance-card__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}
.balance-card__icon {
  font-size: 48rpx;
}
.balance-card__num {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}
.balance-card__label {
  font-size: 23rpx;
  color: var(--ink-2);
}
.balance-card__divider {
  width: 1rpx;
  height: 80rpx;
  background: rgba(28, 28, 30, 0.08);
}

/* 充值档位 */
.plan-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.plan {
  flex: 1;
  min-width: 28%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 24rpx 12rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 4rpx 14rpx rgba(31, 35, 55, 0.05);
  transition: all 150ms var(--ease-out);
}
.plan--on {
  background: linear-gradient(135deg, #2A2A2E 0%, #1C1C1E 100%);
  border-color: transparent;
  box-shadow: 0 10rpx 26rpx rgba(28, 28, 30, 0.24);
}
.plan--on .plan__silver {
  color: #FFFFFF;
}
.plan--on .plan__rmb {
  color: rgba(255, 255, 255, 0.6);
}
.plan--active {
  transform: scale(0.96);
}
.plan__silver {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}
.plan__rmb {
  font-size: 24rpx;
  color: var(--ink-3);
}

.channel-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 28rpx;
}
.chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  font-size: 23rpx;
  color: var(--ink-2);
  box-shadow: 0 4rpx 14rpx rgba(31, 35, 55, 0.05);
  transition: all 150ms var(--ease-out);
}
.chip--on {
  background: linear-gradient(135deg, #2A2A2E 0%, #1C1C1E 100%);
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 8rpx 20rpx rgba(28, 28, 30, 0.20);
}
.chip--active {
  transform: scale(0.95);
}
.channel-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--gold-deep);
  line-height: 1.6;
}
.recharge-btn {
  margin-top: 28rpx;
  width: 100%;
}

/* 兑换 */
.currency-seg {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.seg {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  color: var(--ink-2);
  box-shadow: 0 4rpx 14rpx rgba(31, 35, 55, 0.05);
  transition: all 150ms var(--ease-out);
}
.seg--on {
  background: linear-gradient(135deg, #2A2A2E 0%, #1C1C1E 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 22rpx rgba(28, 28, 30, 0.22);
}
.seg--active {
  transform: scale(0.97);
}
.exchange-row {
  display: flex;
}
.exchange-input {
  flex: 1;
  width: auto; /* 覆盖 .glass-input 的 width:100%，防止 flex 行内撑破 */
  font-size: 32rpx;
  font-weight: 600;
}
.exchange-preview {
  margin-top: 20rpx;
  padding: 20rpx 28rpx;
  border-radius: 28rpx;
  background: var(--gold-soft);
  font-size: 26rpx;
  color: var(--gold-deep);
  font-weight: 600;
  letter-spacing: 1rpx;
}
.exchange-btn {
  margin-top: 24rpx;
  width: 100%;
}

/* 流水 */
.tx-card {
  display: flex;
  flex-direction: column;
  padding: 12rpx 32rpx;
}
.tx-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(28, 28, 30, 0.05);
}
.tx-item:last-child {
  border-bottom: none;
}
.tx-item__icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(28, 28, 30, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--ink-2);
  flex-shrink: 0;
}
.tx-item__body {
  flex: 1;
  min-width: 0;
}
.tx-item__remark {
  font-size: 26rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.tx-item__time {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}
.tx-item__amount {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-2);
  flex-shrink: 0;
}
.tx-item__amount--plus {
  color: var(--success);
}

/* seg 内嵌硬币图标：横向排列居中 */
.seg {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
.seg__label {
  font-size: inherit;
}
