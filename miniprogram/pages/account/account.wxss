/* account —— 账号中心 */
.account-page {
  padding-bottom: 60rpx;
}

.info-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 32rpx;
}
.info-card__icon {
  font-size: 52rpx;
}
.info-card__label {
  font-size: 23rpx;
  color: var(--ink-3);
}
.info-card__id {
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}

.guest-tip {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.8;
  text-align: center;
  padding: 8rpx 0 24rpx;
}
.tip-btn {
  margin-top: 20rpx;
  width: 100%;
}

.section-label {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}
.field {
  margin-bottom: 20rpx;
}
.field__hint {
  margin: 12rpx 4rpx 0;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.6;
}
.form-btn {
  margin-top: 24rpx;
  width: 100%;
}
.ph {
  color: var(--ink-3);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 8rpx;
  border-bottom: 1rpx solid rgba(28, 28, 30, 0.05);
  border-radius: 20rpx;
  transition: background 150ms;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item--active {
  background: rgba(28, 28, 30, 0.03);
}
.menu-item__icon {
  font-size: 36rpx;
}
.menu-item__label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
}
.menu-item__arrow {
  color: var(--ink-3);
  font-size: 36rpx;
}
