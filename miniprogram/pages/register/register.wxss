/* register —— 注册/登录/补注册 */
.register-page {
  padding-top: 48rpx;
}

.register-head {
  text-align: center;
  padding: 24rpx 0 48rpx;
}
.register-head__title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}
.register-head__sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.form-card {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}
.field {
  display: flex;
  flex-direction: column;
}
.field__label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
  letter-spacing: 1rpx;
  margin-bottom: 14rpx;
}
.field__hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--cinnabar);
}
.field__hint--ok {
  color: var(--success);
}

.ph {
  color: var(--ink-3);
}

.pwd-rules {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
}
.pwd-rule {
  font-size: 22rpx;
  color: var(--ink-3);
}
.pwd-rule--ok {
  color: var(--success);
}

.submit-btn {
  margin-top: 40rpx;
  width: 100%;
}

.guest-link {
  margin-top: 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-3);
  padding: 16rpx;
  letter-spacing: 2rpx;
  transition: transform 220ms var(--ease-smooth), opacity 220ms var(--ease-smooth);
}
.guest-link--active {
  transform: scale(0.96);
  opacity: 0.7;
}
